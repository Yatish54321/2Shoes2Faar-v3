# ==============================================================================
# 2SHOES2FAAR — PLATFORM CONFIGURATION
# ==============================================================================

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links and Google Apps Script webhook endpoints.
APP_URL="MY_APP_URL"

# ==============================================================================
# GOOGLE FORM & APPS SCRIPT WEBHOOK CONFIGURATION
# ==============================================================================
# Target Form: https://forms.gle/Nj13LtV9ATqHt8EJA
# Secure secret header to verify incoming Google Apps Script webhook calls
GOOGLE_FORM_WEBHOOK_SECRET="veer_2shoes2faar_secret_2026"

# ==============================================================================
# INSTAGRAM SCRAPER PROVIDER (APIFY) CONFIGURATION
# ==============================================================================
# APIFY_API_TOKEN: API token for Apify (https://console.apify.com/account/integrations)
# Required only on the backend to automatically scrape and sync public Instagram profile metrics.
APIFY_API_TOKEN=

# APIFY_ACTOR_ID: (Optional) Apify Actor ID for Instagram profile scraping
# Default: apify~instagram-profile-scraper
APIFY_ACTOR_ID=

